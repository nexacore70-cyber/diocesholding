<div class="auth-page">

    <div class="auth-container">

        <!-- ======================================
             BRAND
        ======================================= -->

        <div class="auth-brand">

            <span class="auth-brand-mark">N</span>

            <div>
                <span class="auth-brand-name">
                    Nexa<span>Core</span>
                </span>

                <p>Learn. Build. Grow.</p>
            </div>

        </div>


        <!-- ======================================
             HEADER
        ======================================= -->

        <div class="auth-header">

            <span class="auth-eyebrow">
                WELCOME BACK
            </span>

            <h1>
                Welcome<br>
                <span>back.</span>
            </h1>

            <p>
                Sign in to continue your NexaCore journey.
            </p>

        </div>


        <!-- ======================================
             ERROR MESSAGE
        ======================================= -->

        <div
            id="loginError"
            class="auth-message error"
            style="display: none;"
        ></div>


        <!-- ======================================
             SUCCESS MESSAGE
        ======================================= -->

        <div
            id="loginSuccess"
            class="auth-message success"
            style="display: none;"
        ></div>


        <!-- ======================================
             LOGIN FORM
        ======================================= -->

        <form
            id="loginForm"
            class="auth-form"
            novalidate
        >

            <!-- Email -->

            <div class="form-group">

                <label for="email">
                    Email Address
                </label>

                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="you@example.com"
                    autocomplete="email"
                    required
                >

            </div>


            <!-- Password -->

            <div class="form-group">

                <div class="form-label-row">

                    <label for="password">
                        Password
                    </label>

                    <a href="/forgot-password">
                        Forgot password?
                    </a>

                </div>

                <div class="password-wrapper">

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                    >

                    <button
                        type="button"
                        class="password-toggle"
                        data-target="password"
                        aria-label="Show password"
                    >
                        Show
                    </button>

                </div>

            </div>


            <!-- Remember Me -->

            <label class="checkbox-group">

                <input
                    type="checkbox"
                    id="rememberMe"
                    name="rememberMe"
                >

                <span>
                    Keep me signed in
                </span>

            </label>


            <!-- Submit -->

            <button
                type="submit"
                id="loginButton"
                class="auth-submit"
            >

                <span class="button-text">
                    Sign In
                </span>

                <span
                    class="button-loader"
                    style="display: none;"
                >
                    Signing In...
                </span>

            </button>

        </form>


        <!-- ======================================
             FOOTER
        ======================================= -->

        <div class="auth-footer">

            <p>
                Don't have an account?
                <a href="/register">
                    Create one
                </a>
            </p>

        </div>

    </div>

</div>